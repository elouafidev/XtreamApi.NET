<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      Two targets from a single source. net8.0 is the floor that opens the
      library to the widest audience: an application on .NET 8, 9, 10 or beyond
      can consume it. net10.0 is added so the package advertises support for
      the current release explicitly.
    -->
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- Documentation comments ship with the package. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <!--
      CS1591 demands a comment on every public member. This library documents
      what deserves an explanation: the protocol's traps, the design choices,
      the units. Adding one sentence per data property, whose name already says
      everything, would clutter IntelliSense without teaching the consumer
      anything.
    -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>XtreamApi</PackageId>
    <Version>1.0.0</Version>
    <Title>Xtream API SDK for .NET</Title>
    <Description>A .NET client for the Xtream Codes API: authentication, categories, live channels, movies, series, electronic programme guide and playback URL construction. Built to survive the format inconsistencies of real-world panels.</Description>
    <PackageTags>xtream;xtream-codes;iptv;api;client;sdk</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
